{
  "name": "color-memory-engine",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hostable engine for deterministic visual color-memory games.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "lint": "eslint src scripts next.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "node scripts/check-assets.mjs && vitest run src/lib/content/validation.test.ts",
    "assets:manifest": "node scripts/generate-asset-manifest.mjs",
    "build": "npm run validate:content && next build",
    "start": "next start"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "22.x"
  }
}
